{
    "name": "corder/backend",
    "description": "API PHP du site Corder (corder.be)",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "phpmailer/phpmailer": "^6.9",
        "ezyang/htmlpurifier": "^4.17"
    },
    "autoload": {
        "psr-4": {
            "Corder\\": "src/"
        }
    },
    "scripts": {
        "serve": "php -S localhost:8000 -t public public/index.php",
        "seed": "php database/seed.php"
    },
    "config": {
        "platform": {
            "php": "8.1"
        },
        "sort-packages": true
    }
}

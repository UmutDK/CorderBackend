# Copier ce fichier en .env et remplir les valeurs. Le fichier .env n'est jamais versionné.

# development : messages d'erreur détaillés · production : messages génériques
APP_ENV=development
# Adresse du site public (liens dans les e-mails)
APP_URL=http://localhost:4400
# Adresse publique de l'API (lien de confirmation newsletter)
API_URL=http://localhost:8000

# Origines autorisées à appeler l'API (CORS), séparées par des virgules
CORS_ORIGINS=http://localhost:4200,http://localhost:4400

# Base MySQL / MariaDB. Développement : conteneur Docker (docker compose up -d)
# Production cPanel : préfixe du compte inclus, ex. compte_corder
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=corder
DB_USER=corder
DB_PASS=corder

# E-mails. MAIL_DRIVER=log écrit les e-mails dans storage/logs/mail.log (développement)
# MAIL_DRIVER=smtp envoie réellement (production : compte e-mail créé dans cPanel)
MAIL_DRIVER=log
MAIL_HOST=mail.corder.be
MAIL_PORT=465
MAIL_ENCRYPTION=ssl
MAIL_USERNAME=noreply@corder.be
MAIL_PASSWORD=
MAIL_FROM=noreply@corder.be
MAIL_FROM_NAME=Corder

# Destinataires du formulaire de contact. Un pôle sans adresse utilise CONTACT_TO_DEFAULT.
CONTACT_TO_DEFAULT=info@corder.be
CONTACT_TO_CLINIQUE=
CONTACT_TO_CRP=
CONTACT_TO_PHYTOLICENCE=
CONTACT_TO_RECHERCHE=
CONTACT_TO_FORMATION=
# Copie de chaque nouvelle inscription à une formation (vide = aucune)
REGISTRATIONS_NOTIFY=

# Anti-spam : nombre d'envois autorisés par adresse IP et par heure
RATE_LIMIT_PER_HOUR=5
